{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "godot4-full-control": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@tugcantopaloglu/godot-mcp"
      ],
      "environment": {
        "GODOT_PATH": "/usr/bin/godot"
      }
    }
  },
  "plugin": [
    "godot-prompter@git+https://github.com/jame581/GodotPrompter.git"
  ]
}

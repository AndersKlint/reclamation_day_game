[gd_resource type="AudioBusLayout" load_steps=3 format=3]

[sub_resource type="AudioEffectLowPassFilter" id="AudioEffectLowPassFilter_voidwalker"]
resource_name = "Voidwalker Lowpass"
cutoff_hz = 800.0
resonance = 0.5

[sub_resource type="AudioEffectHardLimiter" id="AudioEffectHardLimiter_master"]
resource_name = "Master Safety Limiter"
pre_gain_db = 0.0
ceiling_db = -1.0
release = 0.1

[resource]
bus/0/name = &"Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
bus/0/volume_db = 0.0
bus/0/send = &""
bus/0/effect/0/effect = SubResource("AudioEffectLowPassFilter_voidwalker")
bus/0/effect/0/enabled = false
bus/0/effect/1/effect = SubResource("AudioEffectHardLimiter_master")
bus/0/effect/1/enabled = true
